<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

  <table name="mageos_shopping_feed_feed" resource="default" engine="innodb" comment="Feeds table">
    <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Feed Id"/>
    <column xsi:type="int" name="store_id" padding="10" unsigned="true" nullable="false" comment="Store Id"/>
    <column xsi:type="varchar" name="name" length="255" comment="Name"/>
    <column xsi:type="varchar" name="type" length="100" comment="Type"/>
    <column xsi:type="int" name="status" padding="10" unsigned="true" nullable="false" default="1" comment="Status"/>
    <column xsi:type="int" name="use_microdata" padding="2" unsigned="true" nullable="false" default="0" comment="Use Microdata"/>
    <column xsi:type="text" name="messages" nullable="false" comment="Messages"/>
    <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at timestamp"/>
    <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated at timestamp"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <index referenceId="MAGEOS_SF_FEED_NAME_TYPE" indexType="btree">
      <column name="name"/>
      <column name="type"/>
    </index>
  </table>

  <table name="mageos_shopping_feed_feed_config" resource="default" engine="innodb" comment="Feed configs table">
    <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Config Id"/>
    <column xsi:type="int" name="feed_id" padding="10" unsigned="true" nullable="false" comment="Feed Id"/>
    <column xsi:type="varchar" name="path" length="255" default="NULL" comment="Configuration path"/>
    <column xsi:type="mediumtext" name="value" nullable="false"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <constraint xsi:type="unique" referenceId="MAGEOS_SF_FEED_CONFIG_FEED_ID_PATH">
      <column name="feed_id"/>
      <column name="path"/>
    </constraint>
    <index referenceId="MAGEOS_SF_FEED_CONFIG_PATH" indexType="btree">
      <column name="path"/>
    </index>
    <index referenceId="MAGEOS_SF_FEED_CONFIG_FEED_ID" indexType="btree">
      <column name="feed_id"/>
    </index>
    <constraint xsi:type="foreign" referenceId="MAGEOS_SF_FEED_CONFIG_FEED_ID_MAGEOS_SF_FEED_ID" table="mageos_shopping_feed_feed_config" column="feed_id" referenceTable="mageos_shopping_feed_feed" referenceColumn="id" onDelete="CASCADE"/>
  </table>

  <table name="mageos_shopping_feed_feed_queue" resource="default" engine="innodb" comment="Feed queue table">
    <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Queue Id"/>
    <column xsi:type="int" name="feed_id" padding="10" unsigned="true" nullable="false" comment="Feed Id"/>
    <column xsi:type="int" name="schedule_id" padding="10" unsigned="true" nullable="false" comment="Schedule Id"/>
    <column xsi:type="text" name="message" nullable="false"/>
    <column xsi:type="int" name="is_read" padding="2" unsigned="true" nullable="false" comment="Batch Mode Status"/>
    <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Processed at timestamp"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <index referenceId="MAGEOS_SF_FEED_QUEUE_FEED_ID" indexType="btree">
      <column name="feed_id"/>
    </index>
    <constraint xsi:type="foreign" referenceId="MAGEOS_SF_FEED_QUEUE_FEED_ID_MAGEOS_SF_FEED_ID" table="mageos_shopping_feed_feed_queue" column="feed_id" referenceTable="mageos_shopping_feed_feed" referenceColumn="id" onDelete="CASCADE"/>
  </table>

  <table name="mageos_shopping_feed_feed_schedule" resource="default" engine="innodb" comment="Feed Schedule table">
    <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Schedule Id"/>
    <column xsi:type="int" name="feed_id" padding="10" unsigned="true" nullable="false" comment="Feed Id"/>
    <column xsi:type="int" name="start_at" padding="6" unsigned="true" nullable="false" comment="Schedule hour"/>
    <column xsi:type="timestamp" name="processed_at" on_update="false" nullable="0" default="CURRENT_TIMESTAMP" comment="Keeps track of last time schedule was processed."  onCreate="migrateDataFrom(processed_at)"/>
    <column xsi:type="int" name="batch_mode" padding="5" unsigned="true" nullable="false" default="0" comment="Batch Mode Status"/>
    <column xsi:type="int" name="batch_limit" padding="5" unsigned="true" nullable="false" comment="Number of processed products on batch run"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <constraint xsi:type="unique" referenceId="MAGEOS_SF_FEED_SCHEDULE_FEED_ID_START_AT">
      <column name="feed_id"/>
      <column name="start_at"/>
    </constraint>
    <index referenceId="MAGEOS_SF_FEED_SCHEDULE_FEED_ID" indexType="btree">
      <column name="feed_id"/>
    </index>
    <constraint xsi:type="foreign" referenceId="MAGEOS_SF_FEED_SCHEDULE_FEED_ID_MAGEOS_SF_FEED_ID" table="mageos_shopping_feed_feed_schedule" column="feed_id" referenceTable="mageos_shopping_feed_feed" referenceColumn="id" onDelete="CASCADE"/>
  </table>

  <table name="mageos_shopping_feed_feed_upload" resource="default" engine="innodb" comment="Feed Uploads table">
    <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Upload Id"/>
    <column xsi:type="int" name="feed_id" padding="10" unsigned="true" nullable="false" comment="Feed Id"/>
    <column xsi:type="varchar" name="username" length="255" comment="Upload username"/>
    <column xsi:type="varchar" name="password" length="255" comment="Upload password"/>
    <column xsi:type="varchar" name="host" comment="Upload host"/>
    <column xsi:type="int" name="port" padding="10" unsigned="true" nullable="false" comment="Upload port"/>
    <column xsi:type="varchar" name="path" comment="Upload path"/>
    <column xsi:type="varchar" name="mode" length="255" default="null" comment="Mode - FTP or SFTP"/>
    <column xsi:type="int" name="gzip" padding="5" unsigned="true" nullable="false" comment="Gzip file before sending or not"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <index referenceId="MAGEOS_SF_FEED_UPLOAD_FEED_ID" indexType="btree">
      <column name="feed_id"/>
    </index>
    <constraint xsi:type="foreign" referenceId="MAGEOS_SF_FEED_UPLOAD_FEED_ID_MAGEOS_SF_FEED_ID" table="mageos_shopping_feed_feed_upload" column="feed_id" referenceTable="mageos_shopping_feed_feed" referenceColumn="id" onDelete="CASCADE"/>
  </table>

  <table name="mageos_shopping_feed_process" resource="default" engine="innodb" comment="Process table">
    <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Upload Id"/>
    <column xsi:type="int" name="item_id" padding="10" unsigned="true" nullable="false" comment="Item Id"/>
    <column xsi:type="int" name="parent_item_id" padding="10" unsigned="true" nullable="false" comment="Item Id"/>
    <column xsi:type="int" name="feed_id" padding="10" unsigned="true" nullable="false" comment="Feed Id"/>
    <column xsi:type="int" name="status" padding="10" unsigned="true" nullable="false" default="1" comment="Status"/>
    <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated at timestamp"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <index referenceId="MAGEOS_SF_PROCESS_ITEM_ID_FEED_ID" indexType="btree">
      <column name="item_id"/>
      <column name="feed_id"/>
    </index>
    <index referenceId="MAGEOS_SF_PROCESS_PARENT_ITEM_ID" indexType="btree">
      <column name="parent_item_id"/>
    </index>
    <index referenceId="MAGEOS_SF_PROCESS_STATUS" indexType="btree">
      <column name="status"/>
    </index>
    <index referenceId="MAGEOS_SF_PROCESS_UPDATED_AT" indexType="btree">
      <column name="updated_at"/>
    </index>
    <index referenceId="MAGEOS_SF_PROCESS_FEED_ID" indexType="btree">
      <column name="feed_id"/>
    </index>
    <constraint xsi:type="foreign" referenceId="MAGEOS_SF_FEED_PROCESS_FEED_ID_MAGEOS_SF_FEED_ID" table="mageos_shopping_feed_process" column="feed_id" referenceTable="mageos_shopping_feed_feed" referenceColumn="id" onDelete="CASCADE"/>
  </table>

  <table name="mageos_shopping_feed_shipping" resource="default" engine="innodb" comment="Shipping table">
    <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Upload Id"/>
    <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false" comment="Product Id"/>
    <column xsi:type="int" name="store_id" padding="10" unsigned="true" nullable="false" comment="Store Id"/>
    <column xsi:type="int" name="feed_id" padding="10" unsigned="true" nullable="false" comment="Feed Id"/>
    <column xsi:type="varchar" name="currency_code" length="3" nullable="false" comment="Currency code"/>
    <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated at timestamp"/>
    <column xsi:type="varchar" name="value" length="255" default="" comment="Value"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <index referenceId="MAGEOS_SF_SHPP_PRD_ID_STORE_ID_FEED_ID_CURRENCY_CODE" indexType="btree">
      <column name="product_id"/>
      <column name="store_id"/>
      <column name="feed_id"/>
      <column name="currency_code"/>
    </index>
    <index referenceId="MAGEOS_SF_SHIPPING_UPDATED_AT" indexType="btree">
      <column name="updated_at"/>
    </index>
    <index referenceId="MAGEOS_SF_SHIPPING_FEED_ID" indexType="btree">
      <column name="feed_id"/>
    </index>
    <constraint xsi:type="foreign" referenceId="MAGEOS_SF_FEED_SHIPPING_FEED_ID_MAGEOS_SF_FEED_ID" table="mageos_shopping_feed_shipping" column="feed_id" referenceTable="mageos_shopping_feed_feed" referenceColumn="id" onDelete="CASCADE"/>
  </table>

</schema>
