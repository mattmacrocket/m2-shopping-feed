<?php /** @var $block MageOS\ShoppingFeed\Block\Adminhtml\Feed\Test\Result */?>
<ul class="test-feed-items message-system-inner">
    <?php foreach ($block->getMessages() as $message) :?>
        <li class="message message-info info"><?=$block->escapeHtml($message, ['strong'])?></li>
    <?php endforeach; ?>
</ul>
<?php if ($block->getTestOutput()): ?>
    <?php foreach ($block->getTestOutput() as $section): ?>
        <table class="admin__table-secondary data-table">
            <thead>
                <tr>
                    <th><?=$block->escapeHtml(__('Column'))?></th>
                    <th><?=$block->escapeHtml(__('Value'))?></th>
                </tr>
            </thead>
            <tbody>
            <?php foreach ($section as $row) :?>
                <tr>
                    <td class="label"><strong><?=$block->escapeHtml(__($row['label']))?></strong></td>
                    <td><?=$block->escapeHtml(__($row['value']))?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
        <br />
    <?php endforeach; ?>
<?php endif; ?>
<?php if ($block->getLogOutput()): ?>
    <div class="admin__page-section-item-title log-output">
        <legend class="admin__legend legend">
            <span><?=$block->escapeHtml(__('Log output:'))?></span>
        </legend>
        <div class="message-system-inner">
            <?= $escaper->escapeHtml(nl2br($block->getLogOutput()), ['br']) ?>
        </div>

    </div>

<?php endif; ?>
